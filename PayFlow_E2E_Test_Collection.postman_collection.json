        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderAccountId\": \"<REPLACE_WITH_SENDER_ACCOUNT_ID>\",\n  \"receiverAccountId\": \"<REPLACE_WITH_RECEIVER_ACCOUNT_ID>\",\n  \"amount\": 1500.00\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/transactions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "description": "Resends the exact same transaction request to verify that the Redis idempotency guard handles cache hits and skips execution."
      },
      "response": []
    },
