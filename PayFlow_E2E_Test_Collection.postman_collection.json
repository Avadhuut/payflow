            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"<REPLACE_WITH_SENDER_USER_ID>\",\n  \"initialBalance\": 20000.00\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/accounts",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "description": "Creates a debit account for the sender with a starting balance. Replace userId with the ID returned in step 1."
      },
      "response": []
    },
