  "item": [
    {
      "name": "1. Register Sender User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@payflow.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "description": "Registers a new user who will act as the sender."
      },
      "response": []
    },
    {
      "name": "2. Register Receiver User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@payflow.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "description": "Registers a second user who will act as the receiver."
      },
      "response": []
    },
    {
      "name": "3. Login Sender (Get JWT Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) {",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "    pm.globals.set(\"accessToken\", jsonData.accessToken);",
              "    console.log(\"Access token saved successfully!\");",
              "}",
              "if (jsonData.refreshToken) {",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "    pm.globals.set(\"refreshToken\", jsonData.refreshToken);",
              "    console.log(\"Refresh token saved successfully!\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@payflow.com\",\n  \"password\": \"securePassword123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Logs in the sender to obtain a valid JWT access token and saves it in Postman variables."
      },
      "response": []
    },
    {
      "name": "3a. Refresh JWT Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) {",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "    pm.globals.set(\"accessToken\", jsonData.accessToken);",
              "    console.log(\"Access token saved successfully!\");",
              "}",
              "if (jsonData.refreshToken) {",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "    pm.globals.set(\"refreshToken\", jsonData.refreshToken);",
              "    console.log(\"Refresh token saved successfully!\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/refresh",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "auth",
            "refresh"
          ]
        },
        "description": "Uses the refresh token to rotate and retrieve new access and refresh tokens."
      },
      "response": []
    },
    {
      "name": "3b. User Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/logout",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
