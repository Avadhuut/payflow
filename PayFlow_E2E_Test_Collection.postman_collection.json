    {
      "name": "6. Post Payment Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "tx-key-new-001"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderAccountId\": \"<REPLACE_WITH_SENDER_ACCOUNT_ID>\",\n  \"receiverAccountId\": \"<REPLACE_WITH_RECEIVER_ACCOUNT_ID>\",\n  \"amount\": 1500.00\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/transactions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "description": "Initiates a new payment transaction with a specific Idempotency-Key."
      },
      "response": []
    },
    {
      "name": "7. Re-Post Same Transaction (Verify Idempotency)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Idempotency-Key",
